            android:alpha="0.8"
            android:maxLines="1"
            android:textSize="11sp" />
    </LinearLayout>
<LinearLayout
        android:id="@+id/cell_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_bg_off"
